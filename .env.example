# ── Required for the chat ────────────────────────────────────────────
# Anthropic API key (https://console.anthropic.com/). Without it everything
# else works and the chat replies with a clear error message.
ANTHROPIC_API_KEY=

# ── Optional (values below are the defaults) ─────────────────────────
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_EFFORT=low                  # low | medium | high | xhigh | max
# AGENT_REFUSAL_FALLBACK=true       # server-side fallback on refusal
# AGENT_MAX_TOOL_ITERATIONS=6

# ── E-mail (invites and sign-up confirmation) ─────────────────────────
# `npm run db:up` also starts Mailpit, a fake inbox at http://localhost:8025.
# Without SMTP_URL (outside production) e-mails are only printed in the API log.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Vitrine IA <nao-responda@vitrine.local>
# APP_URL=http://localhost:5173      # used to build the links in e-mails
#
# Real e-mail via Gmail (app password without spaces, "@" as %40), see the README.
# Then test it with: npm run mail:test -w backend -- you@example.com
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=Vitrine IA <you@gmail.com>

# MONGO_URI=mongodb://localhost:27017/catalog_ai
# PORT=4000
# CORS_ORIGIN=http://localhost:5173
# JWT_EXPIRES_IN=8h
# Express "trust proxy": false when clients hit the API directly (npm run dev);
# the number of proxies in front otherwise (docker-compose sets 1 for nginx).
# Trusting a proxy that isn't there lets clients forge X-Forwarded-For and
# dodge the login rate limit.
# TRUST_PROXY=false
# Required in production: your own secret (>= 32 characters):
# JWT_SECRET=
